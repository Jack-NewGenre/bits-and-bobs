{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:worker": "bun build lib/workers/image-worker.ts --target browser --outdir public --entry-naming image-worker.js --minify && bun build lib/workers/text-worker.ts --target browser --outdir public --entry-naming text-worker.js --minify && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "dev": "bun run build:worker && next dev",
    "build": "bun run build:worker && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun run build:worker && vitest run",
    "test:watch": "bun run build:worker && vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@paulmillr/qr": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "esm-potrace-wasm": "^0.5.1",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^1.17.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "whatwg-url": "^16"
  }
}
